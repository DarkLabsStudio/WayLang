package main

func churn(n: int) -> int:
    total := 0
    for i := 0; i < n; i++:
        s := "item-" + "value" + f"{i % 10}"
        total += len(s)
    return total

func map_churn(n: int) -> int:
    m := {"seed": "initial"}
    for i := 0; i < n; i++:
        m[f"key-{i % 100}"] = f"value-{i}"
    return len(m)

func main():
    println(churn(50000))
    println(map_churn(5000))
